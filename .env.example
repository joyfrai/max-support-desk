DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=example.com,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
DJANGO_CROSS_ORIGIN_OPENER_POLICY=same-origin

# Tests and local development may omit MySQL vars to use SQLite.
# Alternative single-line DB config:
# DATABASE_URL=mysql://max_support_desk:change-me@127.0.0.1:3306/max_support_desk?charset=utf8mb4
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=max_support_desk
MYSQL_USER=max_support_desk
MYSQL_PASSWORD=change-me

MAX_BOT_TOKEN=change-me
MAX_WEBHOOK_SECRET=change-me
MAX_NOTIFICATION_CHAT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFICATION_CHAT_ID=
SUPPORT_DESK_PUBLIC_URL=https://example.com
# Generate a token, for example:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SUPPORT_EXTERNAL_API_TOKEN=change-me-external-api-token

MEDIA_ROOT=/app/media
MEDIA_URL=/media/
AUDIT_LOG_RETENTION_DAYS=7
SUPPORT_LOG_LEVEL=INFO

# Docker Compose sets this to redis://127.0.0.1:6379/0 because web/worker use host networking.
# Leave empty for local SQLite/tests memory channel layer outside Docker.
REDIS_URL=
